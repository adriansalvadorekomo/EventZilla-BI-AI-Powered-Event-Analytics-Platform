      "parameters": {
        "jsCode": "// The questions worth asking this week, with today's answer and the decision each informs.\nconst status = $('Read status').first().json;\nconst questions = $('Read questions').first().json;\nconst items = Array.isArray(questions) ? questions : $('Read questions').all().map(i => i.json);\nconst titles = { revenue: 'Revenue', reservations: 'Reservations', customers: 'Customers',\n                 marketing: 'Marketing', quality: 'Data quality' };\nconst fresh = status.gate\n  ? `Figures rebuilt ${new Date(status.built_at).toUTCString()}; gate ${status.gate.passed ? 'passed' : 'FAILED'} (${status.gate.checks_passed} of ${status.gate.checks} checks).`\n  : 'No gate result recorded yet.';\nconst lines = ['# EventZilla \u00b7 decision brief', '', fresh, '', '_Synthetic data, 2022-2025._', ''];\nfor (const key of Object.keys(titles)) {\n  const qs = items.filter(q => q.objective === key);\n  if (!qs.length) continue;\n  lines.push(`## ${titles[key]}`, '');\n  for (const q of qs) lines.push(`- **${q.question}** ${q.value ?? 'not available'}. Decides: ${q.decision}`);\n  lines.push('');\n}\nreturn [{ json: { brief: lines.join('\\n'), questions: items.length, gate_passed: status.gate?.passed ?? null } }];"
      }
    }
