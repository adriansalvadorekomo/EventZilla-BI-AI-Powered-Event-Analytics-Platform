# Copy to v2/.env (git-ignored) and replace every value.
WAREHOUSE_USER=eventzilla
WAREHOUSE_PASSWORD=change-me
LANDING_ACCESS_KEY=change-me
LANDING_SECRET_KEY=change-me-too
# optional: the chatbot (Groq LLaMA 3.3 70B) answers only with a key
GROQ_API_KEY=
# optional: enrichment scraping (ingestion/scrape_enrichment.py)
FIRECRAWL_KEY=
# Metabase API key (Admin settings > Authentication > API keys, Administrators) for analytics/metabase/setup_dashboards.py
MB_API_KEY=
# read-only role used by the API and the analyst assistant
# optional: Grafana admin password (defaults to WAREHOUSE_PASSWORD; never the default admin/admin)
# GRAFANA_ADMIN_PASSWORD=
ANALYST_DB_PASSWORD=change-me-analyst
# local n8n owner, created by the setup step (this machine only)
N8N_OWNER_EMAIL=owner@eventzilla.local
N8N_OWNER_PASSWORD=change-me-n8n
